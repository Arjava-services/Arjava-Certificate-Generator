# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database (SQLite by default, change to postgresql://user:password@localhost/certificates on Hostinger)
DATABASE_URL=sqlite:///./data/certificates.db

# Storage
MAX_FILE_SIZE_MB=25

# Google Sheets API Integration (Optional: service account file or JSON, or API key)
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
# GOOGLE_API_KEY=AIzaSy...

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","*"]
